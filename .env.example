# Perpetual Civil Design Ltd - Environment Configuration

# Resend API Key for sending Contact Form enquiries
# Get your free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Recipient email for all contact form enquiries (explicitly hr@civildesignltd.com)
CONTACT_TO_EMAIL=hr@civildesignltd.com

# Verified sender email in Resend (default onboarding domain or verified domain)
CONTACT_FROM_EMAIL=Perpetual Civil Design <onboarding@resend.dev>
